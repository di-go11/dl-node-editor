# model
# チェックポイントのファイル名に使われる(<model_id>_best.pt / _last.pt)。必須。
# (別のモデルと同じ値にすると、checkpoint を上書き・取り違えるので注意)
model_id = model
training_task_type = Segmentation
training_task = Image
dataset_type = PascalVoc

# model_architecture: SegNet / Unet(encoder 3 段 + decoder 3 段、concat の skip connection を使う小さい U-Net)
model_architecture = SegNet


# Setting Optimizer
optimizer_type = Adam
learning_rate = 0.005

# 種別ごとのハイパーパラメータ。未指定なら各 Optimizer の既定値が使われる。
# 選択中の optimizer_type に関係ないキーは無視される。
#   Adam  : beta1 / beta2 / eps / weight_decay
#   AdamW : beta1 / beta2 / weight_decay
#   SGD   : momentum / nesterov / weight_decay
# weight_decay = 0.0
# beta1 = 0.9
# beta2 = 0.999
# eps = 1e-8
# momentum = 0.9
# nesterov = false

# Setting Loss
# loss_type: CrossEntropy / Mse_loss / Dice_loss / Focal_loss / Combo_loss / Boundary_loss
# 未指定なら CrossEntropy。
# 注意: Dice/Focal/Combo/Boundary は softmax 済みの確率を入力とする前提だが、
#       現状モデル末尾に Softmax は自動付与されない(CrossEntropy は生ロジット前提)。
loss_type = CrossEntropy

# 種別ごとのパラメータ。選択中の loss_type に関係ないキーは無視される。
# クラス数は labelmap.txt から自動で決まるため、ここでは指定しない。
#   Dice_loss / Boundary_loss : (なし)
#   Focal_loss                : gamma / alpha(ともに必須)
#   Combo_loss                : alpha(既定 0.5)
# gamma = 2.0
# alpha = 0.25

# マスクの予約ラベル値(Letterbox 余白)。0〜255。
# 前処理が余白をこの値で埋め、Loss(Mse_loss を除く)と評価がこの値の画素を無視する。
# マスク中の実クラス ID と重ならない値にすること。
ignore_index = 255

# Path
dataset_path = /workspaces/apps/backend/ai-engine/TrainingDataset

# ベストモデル(validation mIoU 最良)の重みを保存するディレクトリ
output_dir = /workspaces/apps/backend/ai-engine/models

# Training
epoch_size = 1
batch_size = 1

# 学習再開(resume)
# resume = true なら output_dir の <model_id>_last.pt から再開する(なければエラー)。
# false / 未指定なら、ファイルがあっても読まずに最初から学習する。
# 再開時、checkpoint がすでに epoch_size まで学習済みならエラーになる(epoch_size を増やすこと)。
# resume = true

# 「直近」チェックポイントを何エポックごとに保存するか(0 = 毎エポック)。
# 最終エポックは この設定にかかわらず必ず保存される。
save_last_every = 0

# Resize
input_width = 256
input_height = 256

# TimeMeasurement
enable_time_measurement = false

# 並列処理を行う際に生成するスレッド数(1: 逐次処理, 1<: 並列処理となる)
thread_count = 4

# Device: cpu / cuda / cuda:N (N は GPU 番号。デフォルトは cuda:0)
device = cuda:0