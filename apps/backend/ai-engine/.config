# model
# model_name = Segnet # ConfigReaderが未対応のキーのため一旦コメントアウト


# Setting Optimizer
optimizer_type = Adam
learning_rate = 0.005

# Path
dataset_path = /workspaces/apps/backend/ai-engine/dataset/train

# ベストモデル(validation mIoU 最良)の重みを保存するディレクトリ
output_dir = /workspaces/apps/backend/ai-engine/models

# Training
epoch_size = 1
batch_size = 1

# Resize
input_width = 256
input_height = 256