# model
# チェックポイントのファイル名に使われる(<model_name>_best.pt / _last.pt)。
# 未指定なら "model" になる。
# model_name = Segnet


# Setting Optimizer
optimizer_type = Adam
learning_rate = 0.005

# Path
dataset_path = /workspaces/apps/backend/ai-engine/dataset/train

# ベストモデル(validation mIoU 最良)の重みを保存するディレクトリ
output_dir = /workspaces/apps/backend/ai-engine/models

# Training
epoch_size = 1
batch_size = 1

# 学習再開(resume)
# resume_from を指定するとその .pt から再開する。空/未指定なら
# output_dir の <model_name>_last.pt があれば自動で再開、なければ最初から。
# resume_from = /workspaces/apps/backend/ai-engine/models/model_last.pt

# 「直近」チェックポイントを何エポックごとに保存するか(0 = 毎エポック)。
# 最終エポックは この設定にかかわらず必ず保存される。
save_last_every = 0

# Resize
input_width = 256
input_height = 256