{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // TypeScript 6.0 では strict が既定で有効だが、意図を設定として明示しておく。
    // 既定値に依存すると、版の変更で静かに緩む危険がある。
    "strict": true,
    // 配列やオブジェクトの添字アクセスの結果を T | undefined にする。
    // nodes[i] が常に存在する前提のコードを、型で防ぐため。
    "noUncheckedIndexedAccess": true,
    // switch で case を網羅していない場合にエラーにする。
    // NodeSpec の oneof のような直和型を扱うとき、層を追加した取りこぼしを検出できる。
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vitest.setup.ts"]
}
