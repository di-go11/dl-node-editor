# =====================================================================
# Jenkins agent(ai-engine / api / web の CI を1台でまかなう)
#   テスト・ビルドと agent の動作に必要なものだけを入れる(デバッガや疎通確認ツールは入れない)
#   - ai-engine : CUDA devel + libtorch + gRPC + ccache(Dockerfile.ai-engine の base からビルドに必要な分だけ)
#   - api       : rust 公式イメージから toolchain をコピー(Dockerfile.api とバージョンを揃える)
#   - web       : node 公式イメージから node/npm をコピー(Dockerfile.web とバージョンを揃える)
# ビルドコンテキスト: .devcontainer(jenkins-agent-entrypoint.sh を COPY するため)
# =====================================================================

# Dockerfile.api / Dockerfile.web のベースイメージと同じ値にする
ARG RUST_VERSION=1.88
ARG NODE_VERSION=24

# ---- Rust toolchain の取り出し元 ----
# clippy / rustfmt はここで入れておく。後の agent ステージでは
# /usr/local/rustup が root 所有になり、jenkins ユーザーからは追加できないため
FROM rust:${RUST_VERSION}-slim-bookworm AS rust-toolchain
RUN rustup component add clippy rustfmt

# ---- Node の取り出し元 ----
FROM node:${NODE_VERSION}-bookworm-slim AS node-toolchain

# ---- LibTorch の取得専用ステージ ----
# ダウンロード・展開にしか使わない wget / unzip を最終イメージに残さないため、別ステージで行う
FROM ubuntu:22.04 AS libtorch
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
# LibTorch (CUDA 13.2 / cxx11 ABI)。Dockerfile.ai-engine と同じバージョンにする
RUN wget -q -O libtorch.zip https://download.pytorch.org/libtorch/cu132/libtorch-shared-with-deps-2.13.0%2Bcu132.zip \
    && unzip -q libtorch.zip \
    && rm libtorch.zip

# ---- 本体 ----
FROM nvidia/cuda:13.2.1-cudnn-devel-ubuntu22.04 AS ci-agent

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- C++(ai-engine)のビルド ---
    build-essential \
    cmake \
    ninja-build \
    ccache \
    # CMakeLists.txt の pkg_check_modules(grpc++ / protobuf)で使う
    pkg-config \
    libopencv-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    # --- C++ テストの実行 ---
    # libtorch の torch_cuda.so が読み込み時に要求する。CPU だけのテストでも無いと起動できない
    libcusparselt0-cuda-13 \
    libnvshmem3-cuda-13 \
    libnccl2 \
    # --- Jenkins agent ---
    # agent プロセスは JVM で動く。controller と同じ JDK 21 に合わせる
    openjdk-21-jre-headless \
    # checkout scm で使う git と、SSH(Deploy Key)での clone・Deploy ステージの ssh
    git \
    openssh-client \
    # entrypoint で controller から agent.jar を取得するため
    curl \
    # cargo / npm が HTTPS でレジストリに接続するため
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # libcusparseLt/libnvshmem はバージョン別サブディレクトリに入り、標準の検索パスに無いため ldconfig に追加する
    && echo "/usr/lib/x86_64-linux-gnu/libcusparseLt/13" > /etc/ld.so.conf.d/cusparselt.conf \
    && echo "/usr/lib/x86_64-linux-gnu/nvshmem/13" > /etc/ld.so.conf.d/nvshmem.conf \
    && ldconfig

# LibTorch
COPY --from=libtorch /opt/libtorch /opt/libtorch
ENV CMAKE_PREFIX_PATH=/opt/libtorch

# Rust toolchain(rustup / cargo / rustc / clippy / rustfmt)
# rustup の配布バイナリは古い glibc 向けにビルドされているので Ubuntu 22.04 でもそのまま動く
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=rust-toolchain /usr/local/cargo  /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup

# Node / npm / npx(corepack・yarn は使わないので npm だけコピーする)
COPY --from=node-toolchain /usr/local/bin/node                /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules/npm    /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# jenkins ユーザーと、キャッシュ用ディレクトリ
# compose で名前付きボリュームをマウントすると、初回はここの所有者(jenkins)が引き継がれる
RUN useradd -m -d /home/jenkins jenkins \
    && mkdir -p /home/jenkins/agent \
                /home/jenkins/.ccache \
                /home/jenkins/.cargo \
                /home/jenkins/.npm \
    && chown -R jenkins:jenkins /home/jenkins

# 各ツールの書き込み先を jenkins 所有のディレクトリに向ける
#   - ccache: /ccache(root 所有)だと書き込めず、CMake の CUDA コンパイラ識別が失敗する
#   - cargo : CARGO_HOME=/usr/local/cargo(root 所有)だとレジストリを取得できない。
#             cargo / rustc 本体は /usr/local/cargo/bin に残るので PATH には残す
#   - npm   : キャッシュはデフォルトの ~/.npm(= /home/jenkins/.npm)を使う
ENV CCACHE_DIR=/home/jenkins/.ccache \
    CCACHE_MAXSIZE=5G \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CARGO_HOME=/home/jenkins/.cargo \
    PATH="/usr/lib/ccache:/usr/local/cargo/bin:${PATH}"

# 動作確認(どれかが欠けていたらイメージのビルド時点で落とす)
RUN cmake --version && ccache --version && protoc --version \
    && rustc --version && cargo --version && cargo clippy --version && cargo fmt --version \
    && node --version && npm --version \
    && java -version

COPY jenkins-agent-entrypoint.sh /usr/local/bin/jenkins-agent-entrypoint.sh
RUN chmod +x /usr/local/bin/jenkins-agent-entrypoint.sh

USER jenkins
WORKDIR /home/jenkins/agent
ENTRYPOINT ["/usr/local/bin/jenkins-agent-entrypoint.sh"]
