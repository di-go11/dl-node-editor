{
  "name": "AI-Engine C++ Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "ai-engine-dev",
  "runServices": ["ai-engine-dev"], // このサービスだけ起動する(未指定だと compose の全サービスが起動する)
  "shutdownAction": "none", // ウィンドウを閉じても compose 全体を止めない(既定の stopCompose だと api-dev まで止まる)
  "workspaceFolder": "/workspaces/apps/backend/ai-engine",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "mhutchie.git-graph",
        "anthropic.claude-code"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools"
      }
    }
  },
  "remoteUser": "root"
}