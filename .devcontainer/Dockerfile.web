FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates: npm が HTTPS でレジストリに接続するために必要
# git: コンテナ内から git 操作を行うため(既存の *-dev サービスと同じ方針)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspaces/apps/frontend
